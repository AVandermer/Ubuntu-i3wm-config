configuration {
    show-icons: true;
    font: "UbuntuMono Nerd Font 14";
}

@theme "~/.cache/wal/rofi-alpha.rasi"

window {
    background-color: @bg;
    border-radius: 12px;
    padding: 10px;
    border: 0px;
}

mainbox, inputbar, listview, element, prompt, entry {
    background-color: transparent;
}

element selected {
    background-color: @sel;
    text-color: @bg;
    border-radius: 8px;
}
