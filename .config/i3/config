set $mod Mod4
font pango:JetBrainsMono 8

for_window [class=".*"] border none

gaps inner 10
gaps outer 5
gaps bottom 45
smart_gaps off

client.focused          #bdae93 #bdae93 #bdae93 #bdae93 #bdae93
client.focused_inactive #bdae93 #bdae93 #bdae93 #bdae93 #bdae93
client.unfocused        #bdae93 #bdae93 #bdae93 #bdae93 #bdae93

exec_always --no-startup-id ~/.local/bin/autotiling

exec_always --no-startup-id xinput set-prop "MSFT0001:01 04F3:31DD Touchpad" "libinput Tapping Enabled" 1

exec_always --no-startup-id xinput set-prop "MSFT0001:01 04F3:31DD Touchpad" "libinput Natural Scrolling Enabled" 1

exec_always --no-startup-id picom -b

exec --no-startup-id setxkbmap -layout us,ru,ua -option "" -option "grp:caps_toggle"

exec --no-startup-id killall ibus-daemon

exec_always --no-startup-id wal -R

exec_always --no-startup-id ~/.config/polybar/launch.sh

exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet

bindsym $mod+Return exec kitty

for_window [class="kitty-popup"] floating enable
for_window [class="kitty-popup"] resize set 1000 600
for_window [class="kitty-popup"] border pixel 0 
for_window [class="kitty-popup"] move scratchpad

bindsym $mod+d exec --no-startup-id rofi -show drun

bindsym XF86Calculator exec gnome-calculator

bindsym $mod+Shift+q kill

bindsym $mod+Shift+r restart

bindsym $mod+Shift+e exec --no-startup-id ~/.config/polybar/scripts/power-menu.sh

bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

bindsym XF86Mail exec --no-startup-id brightnessctl set 5%-
bindsym XF86HomePage exec --no-startup-id brightnessctl set +5%

bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

bindsym Print exec --no-startup-id flameshot gui

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+f fullscreen toggle

bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
floating_modifier $mod
tiling_drag modifier titlebar

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

mode "resize" {

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"
